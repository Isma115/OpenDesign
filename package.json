{
  "name": "trazuvia",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para diseño de interfaces y diagramas de flujo",
  "main": "electron-main.js",
  "scripts": {
    "start": "node scripts/start-electron.cjs",
    "dev": "node scripts/start-electron.cjs --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "design",
    "flowchart",
    "diagram",
    "wireframe"
  ],
  "author": "Trazuvia",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "puppeteer": "^24.43.1"
  },
  "build": {
    "appId": "com.trazuvia.designer",
    "productName": "Trazuvia",
    "icon": "app/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": ["portable"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  }
}
